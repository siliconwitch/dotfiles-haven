// One named workspace per mode, in Mod+1, Mod+2, Mod+3 order. YouTube is first, so it shows at login
workspace "youtube"
workspace "steam"
workspace "desk"

output "HDMI-A-1" {
    // Temporary 1080p30 until the new HDMI cable arrives. The current cable can't hold 4K, and 1080p60 interferes
    // with Wi-Fi. The projector doesn't advertise 1080p30, so this forces CEA-861 VIC 34 timing
    modeline 74.25 1920 2008 2052 2200 1080 1084 1089 1125 "+hsync" "+vsync"
    // mode "3840x2160" // the projector's 4K tops out at 30 Hz
    // scale 2          // keeps the 1080p layout size
}

// YouTube's TV interface only loads for a TV user agent. Its own profile keeps that agent out of the desk browser
spawn-sh-at-startup "chromium --user-data-dir=$HOME/.local/share/youtube-tv --user-agent='Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36 Cobalt/25.lts.30.1034943-gold (unlike Gecko) v8/8.8.278.17-jit gles Starboard/15' --app=https://www.youtube.com/tv"
spawn-sh-at-startup "steam -gamepadui"
spawn-sh-at-startup "foot"

// Volume bar. The volume keys write to its FIFO
spawn-sh-at-startup "mkfifo $XDG_RUNTIME_DIR/wob; tail -f $XDG_RUNTIME_DIR/wob | wob"

binds {
    Mod+1                       hotkey-overlay-title="YouTube"                      { focus-workspace "youtube"; }
    Mod+2                       hotkey-overlay-title="Steam"                        { focus-workspace "steam"; }
    Mod+3                       hotkey-overlay-title="Terminal & browser"           { focus-workspace "desk"; }

    Mod+T                       hotkey-overlay-title="Terminal"                     { spawn "foot"; }
    Mod+B                       hotkey-overlay-title="Browser"                      { spawn "chromium"; }

    Mod+H                       hotkey-overlay-title="Navigate left"                { focus-column-left; }
    Mod+L                       hotkey-overlay-title="Navigate right"               { focus-column-right; }
    Mod+Q                       hotkey-overlay-title="Close window" repeat=false    { close-window; }
    Mod+F                       hotkey-overlay-title="Maximise window"              { maximize-column; }

    Mod+Escape                  hotkey-overlay-title="Projector on/off" repeat=false { spawn "systemctl" "start" "projector-toggle.service"; }

    XF86AudioRaiseVolume                                                            { spawn-sh r#"wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.025+ -l 1.0 && wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{ printf "%d%s\n", $2 * 100 + 0.5, $3 == "[MUTED]" ? " muted" : "" }' > $XDG_RUNTIME_DIR/wob"#; }
    XF86AudioLowerVolume                                                            { spawn-sh r#"wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.025- && wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{ printf "%d%s\n", $2 * 100 + 0.5, $3 == "[MUTED]" ? " muted" : "" }' > $XDG_RUNTIME_DIR/wob"#; }
    XF86AudioMute                                                                   { spawn-sh r#"wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle && wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{ printf "%d%s\n", $2 * 100 + 0.5, $3 == "[MUTED]" ? " muted" : "" }' > $XDG_RUNTIME_DIR/wob"#; }

    Mod+Shift+Slash             hotkey-overlay-title=null                           { show-hotkey-overlay; }
}

input {
    keyboard {
        xkb {
            layout "gb(mac)"
            options "caps:none"
        }
    }
}

cursor {
    hide-when-typing
    hide-after-inactive-ms 3000
}

layout {
    gaps 12
    default-column-width { proportion 0.5; }

    focus-ring {
        width 3
        active-color "#fbb829"
    }
}

prefer-no-csd

window-rule {
    match app-id=r#"^chrome-www\.youtube\.com__tv"#
    open-on-workspace "youtube"
    open-fullscreen true
}

// Big Picture and every game Steam launches (app ids steam_app_*)
window-rule {
    match app-id="^steam"
    open-on-workspace "steam"
    open-fullscreen true
}

window-rule {
    match app-id="^foot$"
    match app-id="^chromium-browser$"
    open-on-workspace "desk"
}

hotkey-overlay {
    skip-at-startup
    hide-not-bound
}

gestures {
    hot-corners {
        off
    }
}
